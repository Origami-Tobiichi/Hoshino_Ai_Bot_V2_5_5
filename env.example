# Contoh isi Environment Variables untuk Render / Koyeb / lainnya.
# JANGAN commit file .env. Isi nilai nyata di dashboard hosting (Environment).

# --- WA (opsional; bot.band juga jalan tanpanya) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
BETABOTZ_API_KEY=
YOUTUBE_API_KEY=

# --- wajib untuk free hosting supaya sesi bot tidak hilang saat rebuild ---
# Buat repo PRIVAT (contoh: <user>/hsnai-backup), lalu GitHub Settings ->
# Developer settings -> Personal access tokens (fine-grained):
# akses repo itu saja dengan izin Contents: Read and write.
GIT_SYNC_URL=https://x-access-token:<PAT_KAMU>@github.com/<user>/hsnai-backup.git

# --- opsional: anti-sleep hosting free ---
# Render mengisi RENDER_EXTERNAL_URL otomatis, jadi biasanya tidak perlu diset.
# KEEPALIVE_URL=https://servismu.onrender.com
